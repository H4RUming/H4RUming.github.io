---
import Base from '../../layouts/Base.astro';
import Detail from '../../components/Detail.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { profile, projects } from '../../data/content.js';

export function getStaticPaths() {
  return Object.keys(projects).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const p = projects[slug];
---
<Base title={`${p.title} | ${profile.name} 포트폴리오`} description={p.subtitle}>
  <div class="wrap page">
    <div class="page-top">
      <a class="back" href={`/#${slug}`}>연혁으로 돌아가기</a>
      <ThemeToggle />
    </div>
    <article class="detail">
      <Detail slug={slug} p={p} headingLevel="h1" />
    </article>
  </div>
  <script>import '../../scripts/interactions.js';</script>
</Base>
