---
import Base from '../../layouts/Base.astro';
import Detail from '../../components/Detail.astro';
import { profile, projects } from '../../data/content.js';

export function getStaticPaths() {
  return Object.keys(projects).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const p = projects[slug];
---
<Base title={`${p.title} · ${profile.name}`} description={p.subtitle}>
  <div class="wrap page">
    <a class="back" href={`/#${slug}`}><span aria-hidden="true">←</span> 연혁으로</a>
    <article class="detail">
      <Detail slug={slug} p={p} headingLevel="h1" />
    </article>
  </div>
  <script>import '../../scripts/interactions.js';</script>
</Base>
