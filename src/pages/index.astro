---
import Base from '../layouts/Base.astro';
import Detail from '../components/Detail.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import DocLinks from '../components/DocLinks.astro';
import { profile, stats, kinds, timeline, projects, skills } from '../data/content.js';

// 연도 내림차순, 같은 해에서는 월이 없는 항목을 맨 위에 두고 월 내림차순. 같은 값이면 데이터 순서 유지.
const monthKey = (m) => (m == null ? 13 : m);
const rows = timeline
  .map((t, i) => {
    const proj = t.project ? projects[t.project] : null;
    return {
      ...t,
      id: `r${i}`,
      brief: t.brief ?? proj?.brief ?? null,
      links: t.links ?? proj?.links ?? null,
      // 줄 자체 자료 + 연결된 프로젝트 자료 (같은 파일은 한 번만)
      docs: [...(t.docs ?? []), ...(proj?.docs ?? [])].filter((d, j, arr) => arr.findIndex((x) => x.src === d.src) === j),
      hasDetail: Boolean(proj),
    };
  })
  .map((r) => ({ ...r, expandable: Boolean(r.brief || r.docs.length) }))
  .sort((a, b) => b.year - a.year || monthKey(b.month) - monthKey(a.month));

const years = [...new Set(rows.map((r) => r.year))];
const counts = Object.fromEntries(Object.keys(kinds).map((k) => [k, rows.filter((r) => r.kind === k).length]));
const strong = new Set(['대상', '최우수상', '우수상']);
---
<Base title={`${profile.name} 포트폴리오`}>
  <div class="wrap">
    <header class="intro">
      <div class="intro-top">
        <h1>{profile.name}<span class="name-en">{profile.nameEn}</span></h1>
        <nav class="links" aria-label="연락처">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.github} rel="noopener">GitHub</a>
          <ThemeToggle />
        </nav>
      </div>
      <p class="affil">{profile.affiliation}</p>
      <dl class="stats">
        {stats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
    </header>

    <main>
      <div class="tl-head">
        <h2 class="section-title">연혁</h2>
        <div class="filters" role="group" aria-label="종류별 보기">
          <button type="button" class="filter" data-filter="all" aria-pressed="true">전체 <span class="count">{rows.length}</span></button>
          {Object.entries(kinds).map(([k, v]) => (
            <button type="button" class="filter" data-filter={k} aria-pressed="false">
              <span class="kind-dot" data-kind={k} aria-hidden="true"></span>{v} <span class="count">{counts[k]}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="hint">줄을 누르면 요약과 상장, 발표자료 표시. 자세히 보기가 있는 항목은 문제 정의부터 결과까지 전체 내용 확인 가능.</p>

      <div class="timeline" data-filterable>
        {years.map((y) => (
          <section class="year" data-year={y}>
            <h3 class="year-label">{y}</h3>
            <ol class="rows">
              {rows.filter((r) => r.year === y).map((r) => (
                <li class:list={['row', { expandable: r.expandable }]} data-kind={r.kind} data-rel={r.project ?? ''}>
                  {r.expandable ? (
                    <button type="button" class="row-head" aria-expanded="false" aria-controls={`${r.id}-body`}>
                      <span class="row-month">{r.month ? `${r.month}월` : ''}</span>
                      <span class="row-main">
                        <span class="row-title">{r.title}</span>
                        <span class="row-org">{r.org}</span>
                      </span>
                      <span class="row-side">
                        <span class="kind">{kinds[r.kind]}</span>
                        <span class:list={['badge', { strong: strong.has(r.badge) }]}>{r.badge}</span>
                        <span class="chev" aria-hidden="true"></span>
                      </span>
                    </button>
                  ) : (
                    <div class="row-head static">
                      <span class="row-month">{r.month ? `${r.month}월` : ''}</span>
                      <span class="row-main">
                        <span class="row-title">{r.title}</span>
                        <span class="row-org">{r.org}</span>
                      </span>
                      <span class="row-side">
                        <span class="kind">{kinds[r.kind]}</span>
                        <span class:list={['badge', { strong: strong.has(r.badge) }]}>{r.badge}</span>
                        <span class="chev none" aria-hidden="true"></span>
                      </span>
                    </div>
                  )}
                  {r.expandable && (
                    <div class="row-body" id={`${r.id}-body`} hidden>
                      {r.brief && (
                        <dl class="brief">
                          <div><dt>문제</dt><dd>{r.brief.problem}</dd></div>
                          <div><dt>한 일</dt><dd>{r.brief.action}</dd></div>
                          <div><dt>결과</dt><dd>{r.brief.result}</dd></div>
                        </dl>
                      )}
                      {r.docs.length > 0 && (
                        <div class="row-docs">
                          <span class="row-docs-label">자료</span>
                          <DocLinks docs={r.docs} caption={r.title} />
                        </div>
                      )}
                      {r.tags && <ul class="tags">{r.tags.map((t) => <li>{t}</li>)}</ul>}
                      {(r.hasDetail || r.links) && (
                        <p class="row-links">
                          {r.hasDetail && (
                            <a class="more" href={`/projects/${r.project}/`} data-open={r.project}>
                              {projects[r.project].title} 자세히 보기
                            </a>
                          )}
                          {r.links?.map((l) => (
                            <a class="more ext" href={l.url} rel="noopener" target="_blank">{l.label}</a>
                          ))}
                        </p>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <section class="skills">
        <h2 class="section-title">기술</h2>
        {skills.map((g) => (
          <div class="skill-group">
            <h3>{g.group}</h3>
            <ul class="tags">{g.items.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </section>
    </main>

    <footer class="foot">
      <p>© {new Date().getFullYear()} {profile.name}</p>
    </footer>
  </div>

  <div class="scrim" data-scrim hidden></div>
  <aside class="panel" data-panel role="dialog" aria-modal="true" aria-label="프로젝트 상세" hidden>
    <div class="panel-bar">
      <button type="button" class="panel-close" data-close>닫기 <kbd>Esc</kbd></button>
    </div>
    {Object.entries(projects).map(([slug, p]) => (
      <article class="detail" data-detail={slug} hidden>
        <Detail slug={slug} p={p} />
      </article>
    ))}
  </aside>

  <script>import '../scripts/interactions.js';</script>
</Base>
