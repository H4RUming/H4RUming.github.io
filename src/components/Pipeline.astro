---
// 클릭하면 단계별 설명이 바뀌는 구조도
const { steps, id } = Astro.props;
const allMine = steps.every((s) => s.mine);
// 담당 구분이 있으면 내가 맡은 첫 단계를 기본으로 보여줌
const first = allMine ? 0 : Math.max(0, steps.findIndex((s) => s.mine));
---
<div class="pipe" data-pipe>
  {!allMine && (
    <p class="pipe-legend"><span class="swatch mine"></span>내가 맡은 단계 <span class="swatch"></span>다른 팀원 담당</p>
  )}
  <ol class="pipe-steps" role="tablist" aria-label="시스템 구조">
    {steps.map((s, i) => (
      <li>
        <button
          type="button"
          role="tab"
          class:list={['pipe-step', { mine: s.mine && !allMine }]}
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === first ? 'true' : 'false'}
          tabindex={i === first ? 0 : -1}
        >
          <span class="pipe-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="pipe-name">{s.name}</span>
          <span class="pipe-tech">{s.tech}</span>
        </button>
      </li>
    ))}
  </ol>
  {steps.map((s, i) => (
    <div
      class="pipe-detail"
      role="tabpanel"
      id={`${id}-panel-${i}`}
      aria-labelledby={`${id}-tab-${i}`}
      hidden={i !== first}
    >
      <p>{s.detail}</p>
    </div>
  ))}
</div>
